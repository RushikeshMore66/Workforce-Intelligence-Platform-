# Backend-specific .gitignore
# These rules mirror the root .gitignore — kept here so the backend
# directory is safe even when checked out independently.

# Virtual environment
.venv/
venv/
env/
ENV/

# Compiled Python
__pycache__/
*.py[cod]
*$py.class

# SQLite / test databases
*.db
*.sqlite
*.sqlite3

# pytest
.pytest_cache/
.coverage
htmlcov/

# mypy
.mypy_cache/

# Distribution
dist/
build/
*.egg-info/
